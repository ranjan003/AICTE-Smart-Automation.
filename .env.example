# AICTE Approval Automation - Environment Configuration Template
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# n8n Ngrok Webhook Base URL (No trailing slash)
VITE_N8N_WEBHOOK_BASE_URL=https://your-ngrok-tunnel.ngrok-free.dev

# OCR.Space Free API Key (Get free key from https://ocr.space/ocrapi)
VITE_OCR_SPACE_API_KEY=your_ocr_space_api_key

# Notification Target Email
VITE_NOTIFICATION_EMAIL=officer@aicte.gov.in
