rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to check authentication and roles
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCollegeAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'College Admin' ||
        request.auth.token.role == 'College Admin'
      );
    }

    function isReviewer() {
      return isAuthenticated() && (
        getUserData().role == 'Reviewer' ||
        request.auth.token.role == 'Reviewer'
      );
    }

    function isBureauOfficer() {
      return isAuthenticated() && (
        getUserData().role == 'Bureau Officer' ||
        request.auth.token.role == 'Bureau Officer'
      );
    }

    // Applications collection:
    // - College Admin can read their own applications and create new applications
    // - Reviewer can read and update stage review fields
    // - Bureau Officer has full administrative oversight
    match /applications/{applicationId} {
      allow read: if true; // Demo mode allows reading
      allow create: if isAuthenticated() || true; // Demo permitted
      allow update: if isAuthenticated() || true;
      allow delete: if isBureauOfficer();
    }

    // Documents collection
    match /documents/{documentId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || true;
      allow delete: if isBureauOfficer();
    }

    // Compliance records
    match /complianceRecords/{complianceId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || true;
      allow delete: if isBureauOfficer();
    }

    // Audit logs collection: Immutable append-only
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Strict immutability
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isBureauOfficer() || (isAuthenticated() && request.auth.uid == userId);
    }
  }
}
